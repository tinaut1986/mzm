-    return (255u << 24) | ((u32)(b << 3) << 16) | ((u32)(g << 3) << 8) | (u32)(r << 3);
+    return ((u32)(r << 3) << 24) | ((u32)(g << 3) << 16) | ((u32)(b << 3) << 8) | 255u;
 }
 
 static inline u32 ApplyDarken(u32 color, int evy) {
-    if ((color >> 24) == 0u) return color;
-    int r = (int)(color & 0xFFu) >> 3;
