-    int r = (int)(color & 0xFFu) >> 3;
-    int g = (int)((color >> 8) & 0xFFu) >> 3;
-    int b = (int)((color >> 16) & 0xFFu) >> 3;
+    if ((color & 0xFFu) == 0u) return color; /* transparent stays transparent */
+    int r = (int)((color >> 24) & 0xFFu) >> 3;
+    int g = (int)((color >> 16) & 0xFFu) >> 3;
+    int b = (int)((color >> 8) & 0xFFu) >> 3;
     r += ((31 - r) * evy) >> 4;
     g += ((31 - g) * evy) >> 4;
     b += ((31 - b) * evy) >> 4;
