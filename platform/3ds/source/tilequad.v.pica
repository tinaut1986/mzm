; Vertex shader for the GPU tile renderer's batched quads
; (port_gpu_renderer.c, the Batch* functions): 2D position and a texture
; coordinate in, clip-space position and the same coordinate out. The
; texture environment does the rest.

; Uniforms
.fvec projection[4]

; Constants
.constf consts(0.0, 1.0, 0.5, 0.0)

; Outputs
.out outpos position
.out outtc0 texcoord0

; Inputs
.alias inpos v0
.alias intc  v1

.proc main
	; position = projection * (x, y, 0.5, 1)
	mov r0.xy, inpos
	mov r0.z, consts.z
	mov r0.w, consts.y
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov outtc0, intc
	end
.end
